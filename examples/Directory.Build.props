<!-- The package versions that build-examples.ps1 compiles every example against (plan
     section 3.5, "Example compilation"). Each temporary project under .build/ finds this
     file, because MSBuild looks for it in the folders above the project. -->
<Project>
  <PropertyGroup>
    <JWTValidatorVersion>2.0.0</JWTValidatorVersion>
    <!-- Only for examples whose file name starts with "di-" (spec section 6.1.3, item 6). -->
    <DependencyInjectionVersion>10.0.14</DependencyInjectionVersion>
  </PropertyGroup>
</Project>
